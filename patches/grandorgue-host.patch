   // can enter in Run()
   DiscardContent();
 }
+
+void GOSoundGroupTask::RenderHost(unsigned frames) {
+  // BuildEngine allocated MAX_FRAME_SIZE; host only uses a bounded view.
+  Assign(GetData(), 2, frames);
+  m_IsToComplete.store(true);
+  m_Active.Move();
+  m_Release.Move();
+  GO_DECLARE_LOCAL_SOUND_BUFFER(buffer, 2, frames)
+  buffer.FillWithSilence();
+  ProcessList(m_Active, false, buffer);
+  ProcessList(m_Release, true, buffer);
+  DeinterleaveFrom(buffer);
+  m_RunState.store(RUN_STATE_DONE);
+}
