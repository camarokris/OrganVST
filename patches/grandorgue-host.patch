   }
   return result;
 }
+
+void GOSoundOrganEngine::RenderHost(
+  GOSoundBufferPlanarMutable *outputs, unsigned count, unsigned frames) {
+  assert(m_LifecycleState.load() == LifecycleState::BUILT);
+  assert(mp_threads.empty());
+  assert(frames > 0 && frames <= m_NSamplesPerBuffer);
+  assert(count == m_OutputStates.size());
+  // Dependency order is explicit, avoiding scheduler and device locks.
+  for (auto *task : mp_TremulantTasks) task->RenderHost(frames);
+  for (auto &task : mp_WindchestTasks) task->RunHost();
+  for (auto *task : mp_AudioGroupTasks) task->RenderHost(frames);
+  for (unsigned i = 0; i < count; ++i) {
+    auto &task = *m_OutputStates[i].mp_task;
+    task.SetHostFrames(frames);
+    task.RunHost();
+    outputs[i].CopyFrom(task);
+  }
+  mp_ReleaseTask->RenderHost();
+  m_SamplerPlayer.AdvanceTime(frames);
+}
